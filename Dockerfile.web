# Образ для веб-редактора (FastAPI)
FROM python:3.12-slim

WORKDIR /app

# Копируем web-зависимости и общий requirements
COPY web/requirements.txt /tmp/requirements-web.txt
RUN pip install --no-cache-dir -r /tmp/requirements-web.txt

# Копируем исходники проекта (нужны config.py, web/, guides и т.д.)
COPY . .

# Веб-редактор должен иметь доступ к тем же файлам (data/, config.py)
# Точка входа — uvicorn из директории /app
WORKDIR /app

# Открываем порт 8000
EXPOSE 8000

# Запуск web-приложения
CMD ["uvicorn", "web.main:app", "--host", "0.0.0.0", "--port", "8000"]
