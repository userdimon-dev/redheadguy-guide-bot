# ===== Токен бота =====
# Токен от @BotFather (обязательно)
BOT_TOKEN=your_bot_token_here

# ===== Админ-панель =====
# Telegram ID администратора (можно несколько через запятую)
# Узнать свой ID: напишите @userinfobot
ADMIN_ID=123456789

# ===== Ссылки =====
# Основной бот (если не задан — используется дефолтный)
MAIN_BOT_URL=https://t.me/redheadguy_bot

# Дополнительные ссылки (необязательно, показываются кнопками в show_bot_links)
CHANNEL_URL=
CABINET_URL=
SUPPORT_URL=
SITE_URL=

# ===== Веб-редактор =====
# Имя пользователя бота (без @) — для кнопки «Войти через Telegram»
BOT_USERNAME=your_bot_username

# Название сайта (отображается в шапке веб-редактора)
# WEB_SITE_NAME=RedheadGuy Admin
